{
"manifest_version": 3,
"name": "DeepShield Live Detection",
"version": "1.2.0",
"description": "Real-time deepfake audio detection for browser-based video calls.",
"permissions": [
"tabCapture",
"tabs",
"storage",
"activeTab"
],
"host_permissions": [
"http://127.0.0.1:8000/*",
"http://localhost:8000/*",
"https://api.deepshield.app/*"
],
"action": {
"default_title": "DeepShield Live Detection",
"default_popup": "popup/popup.html",
"default_icon": {
"16": "icons/icon16.png",
"32": "icons/icon32.png",
"48": "icons/icon48.png",
"128": "icons/icon128.png"
}
},
"background": {
"service_worker": "background/background.js"
},
"content_scripts": [
{
"matches": [
"https://*/*",
"http://*/*"
],
"js": [
"content/content.js"
],
"run_at": "document_idle"
}
],
"web_accessible_resources": [
{
"resources": [
"capture/capture.html",
"capture/capture.js"
],
"matches": [
"<all_urls>"
]
}
],
"options_page": "popup/settings.html",
"icons": {
"16": "icons/icon16.png",
"32": "icons/icon32.png",
"48": "icons/icon48.png",
"128": "icons/icon128.png"
}
}
